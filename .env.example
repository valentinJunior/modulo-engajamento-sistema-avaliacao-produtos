# ------------------------------------------------------------------
# Supabase — copie para .env.local e preencha UMA das opções abaixo
# (nunca coloque valores reais neste arquivo: ele vai para o git)
# ------------------------------------------------------------------

# Opção A) Supabase local (valores exibidos por `bun run db:status`)
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=

# Opção B) Supabase externo (projeto hospedado em supabase.com)
# Dashboard → Project Settings → API / API Keys
SUPABASE_URL=
# Use a "secret key" (sb_secret_...) OU a chave legada "service_role":
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Usado por `bun run db:link` / `db:push` para aplicar migrations no projeto externo
# (ref = subdomínio da URL; senha = Project Settings → Database)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------------
# Sessão (sign-in): segredo para assinar o cookie, mínimo 32 caracteres
# gere com: openssl rand -base64 48
# ------------------------------------------------------------------
SESSION_SECRET=

# Chave exigida no header `x-admin-key` de POST /api/v1/products.create
ADMIN_API_KEY=
