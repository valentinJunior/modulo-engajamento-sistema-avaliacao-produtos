{
  "name": "modulo-engajamento-sistema-avaliacao-produto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migration:new": "supabase migration new",
    "db:link": "bun --env-file=.env.local run db:link:run",
    "db:link:run": "supabase link --project-ref \"$SUPABASE_PROJECT_REF\"",
    "db:push": "bun --env-file=.env.local x supabase db push --linked",
    "db:migrations:remote": "bun --env-file=.env.local x supabase migration list --linked",
    "n8n:up": "docker compose -f n8n/compose.yml up -d",
    "n8n:down": "docker compose -f n8n/compose.yml down",
    "n8n:logs": "docker compose -f n8n/compose.yml logs -f n8n"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.5",
    "@mastra/core": "^1.83.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.28.0",
    "@trpc/server": "^11.28.0",
    "@trpc/tanstack-react-query": "^11.28.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
